{
  "name": "AI BOSS",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Juego AI BOSS",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm test",
  "postAttachCommand": "npm start",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
